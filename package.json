{
  "name": "@kkauto/kkauto-mcp",
  "version": "0.3.6",
  "type": "module",
  "description": "MCP stdio adapter for kkAuto API v2 content tools.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkauto-net/kkauto-mcp.git"
  },
  "keywords": [
    "kkauto",
    "facebook",
    "automation",
    "socials"
  ],
  "main": "dist/server.js",
  "bin": {
    "kkauto-mcp": "dist/server.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "prepack": "npm run build",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/tools/fb-posts.test.js dist/tools/source-posts.test.js dist/tools/source-workflows.test.js dist/tools/source-crawlers.test.js dist/config.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.22.3",
    "typescript": "6.0.3"
  }
}
